# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Copy this file to .env.local and fill in the values from your Supabase Project:
# Supabase Dashboard -> Project Settings -> API
#
# DO NOT commit .env.local to version control or share secret keys in chat.
# ==============================================================================

# Public Supabase API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (Safe for client-side use with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (NEVER expose to client code or browser!)
# Used ONLY in secure server-side operations / scripts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authorized Admin Email (Must match the email registered in Supabase Auth and admin_users table)
ADMIN_EMAIL=admin@example.com